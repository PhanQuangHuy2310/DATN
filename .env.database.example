# Windows local development: copy to .env.database in DATN root.
# NEVER paste passwords, cookies, Supabase secret keys into chat or Git.
# Host, port and username: Supabase Dashboard -> Connect -> Session pooler.
DB_HOST=your-project.pooler.supabase.com
DB_PORT=5432
DB_NAME=postgres
DB_USER=eas_backend_login.YOUR_PROJECT_REF
DB_PASSWORD='replace-with-BACKEND-role-password'
DB_SSLMODE=require

# Avoid DATABASE_URL and EAS_API_DATABASE_URL here when using the DB_* fields.
EAS_ENV=development
EAS_RELEASE=local
DJANGO_DEBUG=true
DJANGO_SECRET_KEY=replace-with-random-50-plus-characters
DJANGO_ALLOWED_HOSTS=localhost,127.0.0.1
DJANGO_CSRF_TRUSTED_ORIGINS=http://127.0.0.1:5173,http://localhost:5173
EAS_REQUIRE_ACTIVE_RELEASES=true
# false (default): optional active types missing release are diagnostic warnings;
# P0 releases still required. true: all active request types must be published.
EAS_REQUIRE_FULL_CATALOG_READY=false
EAS_REQUIRE_MOCK_SOURCES=true
EAS_ALLOW_ADMIN_DB=false

# Phase 1: readiness without upload/antivirus; change to true only
# after implementing and testing the actual Storage + ClamAV integration.
EAS_REQUIRE_STORAGE=false
SUPABASE_URL=https://YOUR_PROJECT_REF.supabase.co
SUPABASE_SECRET_KEY=
EAS_STORAGE_BUCKET=eas-private
EAS_CLAMAV_HOST=127.0.0.1
EAS_CLAMAV_PORT=3310

# Generate one random secret and enter SAME value in ai_service/.env.
EAS_AI_SERVICE_URL=http://127.0.0.1:8001
EAS_AI_INTERNAL_SECRET=eas-local-dev-shared-internal-secret-2026
EAS_AI_TIMEOUT_SECONDS=10

# Report v1 expanded request catalog; opt-in only AFTER DBA-approved schema migration.
EAS_ALLOW_REPORT_CATALOG_EXPANSION=false
