# PostgreSQL connection used only by the trusted backend.
# Require TLS in non-local environments, for example sslmode=require.
DATABASE_URL=postgresql://eas_backend_login:change-me@db.example.invalid:5432/postgres?sslmode=require
# Compose reads these host/secret-manager values and overrides any legacy env_file DSN.
EAS_API_DATABASE_URL=postgresql://eas_backend_login:change-me@db.example.invalid:5432/postgres?sslmode=require
EAS_WORKER_DATABASE_URL=postgresql://eas_worker_login:change-me@db.example.invalid:5432/postgres?sslmode=require

# Django runtime
DJANGO_SECRET_KEY=replace-with-at-least-50-random-characters
DJANGO_DEBUG=false
DJANGO_ALLOWED_HOSTS=localhost,127.0.0.1
DJANGO_CSRF_TRUSTED_ORIGINS=https://app.example.invalid
# Compose variable; include the exact public scheme, host and port used by browsers.
EAS_CSRF_TRUSTED_ORIGINS=http://localhost:8080,http://127.0.0.1:8080
# Compose runtime injection variables; do not persist real values in this file.
EAS_DJANGO_SECRET_KEY=replace-through-secret-manager
EAS_SUPABASE_URL=https://project-ref.supabase.co
EAS_SUPABASE_SECRET_KEY=replace-through-secret-manager
EAS_TRUST_PROXY_HEADERS=false
EAS_HSTS_PRELOAD=false
EAS_ALLOW_ADMIN_DB=false
EAS_REQUIRE_ACTIVE_RELEASES=true
EAS_REQUIRE_MOCK_SOURCES=true

# Private attachment storage; rotate any value ever pasted into chat or Git.
SUPABASE_URL=https://project-ref.supabase.co
SUPABASE_SECRET_KEY=replace-through-secret-manager
EAS_STORAGE_BUCKET=eas-private
EAS_CLAMAV_HOST=clamav
EAS_CLAMAV_PORT=3310
EAS_REQUIRE_STORAGE=true
REDIS_URL=redis://redis:6379/0
