# Standalone Django API configuration (not read by Docker Compose).
# Copy to api_core/.env only when your process manager explicitly loads it.
EAS_ENV=development
EAS_RELEASE=local
LOG_LEVEL=INFO

DATABASE_URL=postgresql://eas_backend_login:replace-me@db.example.invalid:5432/postgres?sslmode=require
DJANGO_SECRET_KEY=replace-with-at-least-50-random-characters
DJANGO_DEBUG=false
DJANGO_ALLOWED_HOSTS=localhost,127.0.0.1
DJANGO_CSRF_TRUSTED_ORIGINS=http://localhost:5173,http://127.0.0.1:5173

REDIS_URL=redis://127.0.0.1:6379/0
EAS_SESSION_AGE_SECONDS=28800
EAS_LOGIN_MAX_ATTEMPTS=5
EAS_LOGIN_WINDOW_SECONDS=900
EAS_ALLOW_ADMIN_DB=false
EAS_REQUIRE_ACTIVE_RELEASES=true
EAS_REQUIRE_MOCK_SOURCES=true

SUPABASE_URL=https://project-ref.supabase.co
SUPABASE_SECRET_KEY=
EAS_STORAGE_BUCKET=eas-private
EAS_CLAMAV_HOST=127.0.0.1
EAS_CLAMAV_PORT=3310
EAS_REQUIRE_STORAGE=false

EAS_TRUST_PROXY_HEADERS=false
EAS_SSL_REDIRECT=true
EAS_HSTS_PRELOAD=false
