# Standalone outbox worker configuration (not read by Docker Compose).
# The database login must belong only to eas_worker.
EAS_ENV=development
EAS_RELEASE=local
LOG_LEVEL=INFO

DATABASE_URL=postgresql://eas_worker_login:replace-me@db.example.invalid:5432/postgres?sslmode=require
DJANGO_SECRET_KEY=replace-with-the-same-runtime-secret-as-the-api
REDIS_URL=redis://127.0.0.1:6379/0
EAS_ALLOW_ADMIN_DB=false
EAS_REQUIRE_ACTIVE_RELEASES=true
EAS_REQUIRE_MOCK_SOURCES=true

# Required by attachment-processing jobs.
SUPABASE_URL=https://project-ref.supabase.co
SUPABASE_SECRET_KEY=
EAS_STORAGE_BUCKET=eas-private
EAS_CLAMAV_HOST=127.0.0.1
EAS_CLAMAV_PORT=3310
EAS_REQUIRE_STORAGE=false
