# Canonical host-side configuration for Docker Compose.
# Copy this file to .env, replace every placeholder, then run:
#   python scripts/validate_env.py --file .env --profile compose
# Never commit .env or paste its secret values into chat, tickets, or logs.

# Local ingress
EAS_WEB_PORT=8080

# Runtime identity
EAS_ENV=development
EAS_RELEASE=local
EAS_LOG_LEVEL=INFO

# Use two different least-privilege PostgreSQL logins. Never use postgres,
# supabase_admin, a database owner, or the migration role at runtime.
EAS_API_DATABASE_URL=postgresql://eas_backend_login:replace-me@db.example.invalid:5432/postgres?sslmode=require
EAS_WORKER_DATABASE_URL=postgresql://eas_worker_login:replace-me@db.example.invalid:5432/postgres?sslmode=require

# Generate at least 50 random characters; this is not a Supabase JWT/key.
EAS_DJANGO_SECRET_KEY=replace-with-at-least-50-random-characters

# Server-only Supabase Storage credentials. Use a rotated secret key and keep
# this value empty only when EAS_REQUIRE_STORAGE=false in local development.
EAS_SUPABASE_URL=https://project-ref.supabase.co
EAS_SUPABASE_SECRET_KEY=
EAS_STORAGE_BUCKET=eas-private
EAS_REQUIRE_STORAGE=false

# Browser-facing origins and host validation (comma-separated, no paths).
EAS_DJANGO_ALLOWED_HOSTS=localhost,127.0.0.1,api
EAS_CSRF_TRUSTED_ORIGINS=http://localhost:8080,http://127.0.0.1:8080,http://localhost:8081,http://127.0.0.1:8081,http://localhost:5173,http://127.0.0.1:5173,http://localhost:5174,http://127.0.0.1:5174

# Runtime controls
EAS_DJANGO_DEBUG=false
EAS_REQUIRE_ACTIVE_RELEASES=true
EAS_REQUIRE_MOCK_SOURCES=true
EAS_SESSION_AGE_SECONDS=28800
EAS_SESSION_IDLE_SECONDS=1800
EAS_LOGIN_MAX_ATTEMPTS=5
EAS_LOGIN_MAX_IP_ATTEMPTS=30
EAS_LOGIN_WINDOW_SECONDS=900
EAS_LOGIN_EMAIL_DOMAIN=eas.com
# Local seed accounts only (no default in code). Leave empty in shared/prod envs.
# EAS_DEV_DEFAULT_PASSWORD unlocks placeholder hashes in development only;
# EAS_SEED_PASSWORD (>=15 chars) is hashed by fix_seed_passwords_local.py and
# every updated account must change it at first sign-in.
EAS_DEV_DEFAULT_PASSWORD=
EAS_SEED_PASSWORD=
# Optional SMTP settings for admin-approved password reset emails. Leave blank
# until a real provider is configured; never commit credentials to this file.
EAS_EMAIL_HOST=
EAS_EMAIL_PORT=587
EAS_EMAIL_USER=
EAS_EMAIL_PASSWORD=
EAS_EMAIL_USE_TLS=true
EAS_EMAIL_USE_SSL=false
EAS_EMAIL_FROM=
EAS_EMAIL_TIMEOUT_SECONDS=10
# Development/test only: redirect ALL reset notifications and temporary
# passwords to one inbox you control. Production refuses this setting.
EAS_EMAIL_TEST_RECIPIENT=
EAS_TRUST_PROXY_HEADERS=false
EAS_SSL_REDIRECT=true
EAS_HSTS_PRELOAD=false

# Django and AI Service use the SAME random internal secret. Must be set.
INTERNAL_API_SECRET=replace-with-random-long-internal-api-secret
# Worker -> API call that lets the AI auto-approve risk weight 1-2 steps.
# Required in production (>=32 random chars); dev/test use a built-in default.
EAS_WORKER_INTERNAL_SECRET=
EAS_AI_AUTO_APPROVE_ENABLED=true
EAS_AI_AUTO_APPROVE_MAX_WEIGHT=2
# Optional LLM functionality
GEMINI_API_KEY=

# Report v1 expanded request catalog; opt-in only AFTER DBA-approved schema migration.
EAS_ALLOW_REPORT_CATALOG_EXPANSION=false

# Local service discovery (Docker uses the service name via docker-compose.yml)
EAS_AI_TIMEOUT_SECONDS=10
EAS_DB_CONN_MAX_AGE=60
# Optional limits; set lower only after measuring real Supabase latency.
EAS_DB_CONNECT_TIMEOUT_SECONDS=8
EAS_DB_STATEMENT_TIMEOUT_MS=20000
# Admin portal runs separately from the employee portal
EAS_ADMIN_WEB_PORT=8081
VITE_ADMIN_PORTAL_URL=http://127.0.0.1:5174

# Optional integrations and AI service settings
EAS_ALLOW_ADMIN_DB=false
EAS_CLAMAV_HOST=clamav
EAS_CLAMAV_PORT=3310
AI_SERVICE_HOST=0.0.0.0
AI_SERVICE_PORT=8001
AI_SERVICE_RELOAD=false
OCR_LANG=vi
OCR_USE_GPU=false
AUTO_APPROVE_MAX_RISK=2
AUTO_APPROVE_ONLY_TEMPLATE_A=true
RISK_MODEL_PATH=models/risk_model.pkl
RISK_LABEL_ENCODER_PATH=models/label_encoder.pkl
RISK_FEATURE_COLUMNS_PATH=models/feature_columns.json
SUPABASE_ANON_KEY=

# Redis. Docker services get REDIS_URL=redis://redis:6379/0 from compose.
# Outside Docker either set REDIS_URL, or EAS_REDIS_HOST/EAS_REDIS_PORT
# (port defaults to 6380 = the compose Redis published on the host, so an
# existing Redis on 6379 is left alone). Leave all empty to run without Redis.
REDIS_URL=
EAS_REDIS_HOST=
EAS_REDIS_PORT=
EAS_REDIS_HOST_PORT=6380

# Leave empty to use the Vite development proxy.
VITE_API_BASE_URL=
