# Canonical host-side configuration for Docker Compose.
# Copy this file to .env, replace every placeholder, then run:
#   python scripts/validate_env.py --file .env --profile compose
# Never commit .env or paste its secret values into chat, tickets, or logs.

# Local ingress
EAS_WEB_PORT=8080

# Runtime identity
EAS_ENV=development
EAS_RELEASE=local
EAS_LOG_LEVEL=INFO

# Use two different least-privilege PostgreSQL logins. Never use postgres,
# supabase_admin, a database owner, or the migration role at runtime.
EAS_API_DATABASE_URL=postgresql://eas_backend_login:replace-me@db.example.invalid:5432/postgres?sslmode=require
EAS_WORKER_DATABASE_URL=postgresql://eas_worker_login:replace-me@db.example.invalid:5432/postgres?sslmode=require

# Generate at least 50 random characters; this is not a Supabase JWT/key.
EAS_DJANGO_SECRET_KEY=replace-with-at-least-50-random-characters

# Server-only Supabase Storage credentials. Use a rotated secret key and keep
# this value empty only when EAS_REQUIRE_STORAGE=false in local development.
EAS_SUPABASE_URL=https://project-ref.supabase.co
EAS_SUPABASE_SECRET_KEY=
EAS_STORAGE_BUCKET=eas-private
EAS_REQUIRE_STORAGE=false

# Browser-facing origins and host validation (comma-separated, no paths).
EAS_DJANGO_ALLOWED_HOSTS=localhost,127.0.0.1,api
EAS_CSRF_TRUSTED_ORIGINS=http://localhost:8080,http://127.0.0.1:8080

# Runtime controls
EAS_DJANGO_DEBUG=false
EAS_REQUIRE_ACTIVE_RELEASES=true
EAS_REQUIRE_MOCK_SOURCES=true
EAS_SESSION_AGE_SECONDS=28800
EAS_LOGIN_MAX_ATTEMPTS=5
EAS_LOGIN_WINDOW_SECONDS=900
EAS_TRUST_PROXY_HEADERS=false
EAS_SSL_REDIRECT=true
EAS_HSTS_PRELOAD=false
