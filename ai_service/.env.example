# Biến môi trường cho AI Service
# Copy file này thành .env và điền giá trị thực

# === Server ===
AI_SERVICE_HOST=0.0.0.0
AI_SERVICE_PORT=8001
AI_SERVICE_RELOAD=true

# === Gemini API (LLM Summarize) ===
# Lấy tại: https://aistudio.google.com/app/apikey
GEMINI_API_KEY=your_gemini_api_key_here

# === Supabase (đọc data nếu cần) ===
SUPABASE_URL=https://emnusiybdkpibtqsplta.supabase.co
SUPABASE_ANON_KEY=eyJhbGciOiJIUzI1NiIsInR5cCI6IkpXVCJ9.eyJpc3MiOiJzdXBhYmFzZSIsInJlZiI6ImVtbnVzaXliZGtwaWJ0cXNwbHRhIiwicm9sZSI6ImFub24iLCJpYXQiOjE3ODkwNDg5MjMsImV4cCI6MjEwNDYyNDkyM30.r_L7paWZpweHhuBLWrbr_Mx58VYxjGecgg6HzuLLxHI

# === Model paths ===
RISK_MODEL_PATH=models/risk_model.pkl
RISK_LABEL_ENCODER_PATH=models/label_encoder.pkl
RISK_FEATURE_COLUMNS_PATH=models/feature_columns.json

# === Internal Secret (Django → AI Service auth) ===
INTERNAL_API_SECRET=datn-internal-secret-change-in-prod

# === OCR Settings ===
OCR_LANG=vi          # tiếng Việt
OCR_USE_GPU=false    # set true nếu có GPU

# === Auto-Approve Thresholds ===
AUTO_APPROVE_MAX_RISK=2         # risk score <= 2 thì auto approve
AUTO_APPROVE_ONLY_TEMPLATE_A=true
