# Biến môi trường cho AI Service
# Copy file này thành ai_service/.env và điền giá trị thực (KHÔNG commit .env)

# === Server ===
AI_SERVICE_HOST=127.0.0.1
AI_SERVICE_PORT=8001
AI_SERVICE_RELOAD=true

# === Gemini API (LLM Summarize) ===
# Lấy tại: https://aistudio.google.com/app/apikey
GEMINI_API_KEY=

# === Supabase (đọc data nếu cần) ===
# Không đặt anon/service-role key thật trong file mẫu
SUPABASE_URL=
SUPABASE_ANON_KEY=

# === Model paths (tương đối với thư mục ai_service) ===
RISK_MODEL_PATH=models/risk_model.pkl
RISK_LABEL_ENCODER_PATH=models/label_encoder.pkl
RISK_FEATURE_COLUMNS_PATH=models/feature_columns.json

# === Internal Secret (Django → AI Service auth) ===
# Phải trùng với EAS_AI_INTERNAL_SECRET của Django; để trống thì AI service trả 503
INTERNAL_API_SECRET=replace-with-the-same-random-secret-as-Django

# === OCR Settings ===
# Ngôn ngữ nhận diện tiếng Việt
OCR_LANG=vi
# Chế độ GPU (false nếu chỉ dùng CPU)
OCR_USE_GPU=false

# === Auto-Approve Thresholds ===
# Ngưỡng risk score tối đa để auto-approve (<= 2)
AUTO_APPROVE_MAX_RISK=2
AUTO_APPROVE_ONLY_TEMPLATE_A=true
